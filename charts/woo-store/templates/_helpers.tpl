{{/*
Shared naming and label helpers. Every resource name is "<release>-<component>",
e.g. release "main" -> "main-mariadb".
*/}}

{{/* Selector labels: the minimal, never-changing set a Service/StatefulSet uses to find pods.
Usage: include "woo-store.selectorLabels" (list . "mariadb") */}}
{{- define "woo-store.selectorLabels" -}}
{{- $ctx := index . 0 -}}
app.kubernetes.io/name: {{ index . 1 }}
app.kubernetes.io/instance: {{ $ctx.Release.Name }}
{{- end }}

{{/* Full label set for any resource: selector labels + chart metadata.
Usage: include "woo-store.labels" (list . "mariadb") */}}
{{- define "woo-store.labels" -}}
{{- $ctx := index . 0 -}}
{{ include "woo-store.selectorLabels" . }}
app.kubernetes.io/part-of: woo-store
app.kubernetes.io/managed-by: {{ $ctx.Release.Service }}
helm.sh/chart: {{ $ctx.Chart.Name }}-{{ $ctx.Chart.Version }}
{{- end }}

{{- define "woo-store.siteUrl" -}}
{{ .Values.store.scheme }}://{{ .Values.store.host }}
{{- end }}

{{/*
Env vars that wp-config.php (generated by the official image) reads at runtime.
Shared by the WordPress container and the setup Job so WP-CLI sees the exact same config.
*/}}
{{- define "woo-store.wordpressEnv" -}}
- name: WORDPRESS_DB_HOST
  value: "{{ .Release.Name }}-mariadb:3306"
- name: WORDPRESS_DB_NAME
  value: {{ .Values.mariadb.database | quote }}
- name: WORDPRESS_DB_USER
  value: {{ .Values.mariadb.user | quote }}
- name: WORDPRESS_DB_PASSWORD
  valueFrom:
    secretKeyRef:
      name: {{ include "woo-store.secretName" . }}
      key: mariadb-password
# Evaluated by wp-config.php on every request (not only first start),
# so changing the host/scheme in values takes effect on upgrade.
- name: WORDPRESS_CONFIG_EXTRA
  value: |
    define('WP_HOME', '{{ include "woo-store.siteUrl" . }}');
    define('WP_SITEURL', '{{ include "woo-store.siteUrl" . }}');
    define('WP_ENVIRONMENT_TYPE', '{{ .Values.wordpress.environmentType }}');
{{- end }}

{{- define "woo-store.secretName" -}}
{{- if .Values.existingSecret -}}
{{ .Values.existingSecret }}
{{- else -}}
{{ .Release.Name }}-store-credentials
{{- end -}}
{{- end }}

{{/*
Return an existing secret value (already base64) if present, otherwise a newly
generated one. Keeps passwords stable across upgrades and reinstalls.
Usage: include "woo-store.secretValue" (list $existingData "key" (randAlphaNum 32))
*/}}
{{- define "woo-store.secretValue" -}}
{{- $data := index . 0 -}}
{{- $key := index . 1 -}}
{{- if hasKey $data $key -}}
{{ index $data $key }}
{{- else -}}
{{ index . 2 | b64enc }}
{{- end -}}
{{- end }}

{{/* woo-mcp image; the tag must come from the Makefile/deployer (.image-tag), never a default. */}}
{{- define "woo-store.wooMcpImage" -}}
{{- if not .Values.wooMcp.image.tag -}}
{{- fail "wooMcp.image.tag is required (make store sets it from .image-tag)" -}}
{{- end -}}
{{ .Values.wooMcp.image.repository }}:{{ .Values.wooMcp.image.tag }}
{{- end }}

{{/* Env shared by the woo-mcp server and its helm-test selfcheck pod (DESIGN §9.1). */}}
{{- define "woo-store.wooMcpEnv" -}}
{{- $svc := printf "%s-woo-mcp" .Release.Name -}}
{{- $ns := .Release.Namespace -}}
- name: STORE_SLUG
  value: {{ .Release.Name | quote }}
- name: WC_INTERNAL_URL
  value: "http://{{ .Release.Name }}-wordpress"
- name: WC_PUBLIC_HOST
  value: {{ .Values.store.host | quote }}
- name: WC_CONSUMER_KEY
  valueFrom:
    secretKeyRef:
      name: {{ include "woo-store.secretName" . }}
      key: wc-consumer-key
- name: WC_CONSUMER_SECRET
  valueFrom:
    secretKeyRef:
      name: {{ include "woo-store.secretName" . }}
      key: wc-consumer-secret
- name: STORE_TIMEOUT_MS
  value: {{ .Values.wooMcp.storeTimeoutMs | quote }}
- name: MCP_AUTH_MODE
  value: bearer
- name: MCP_AUTH_TOKEN
  valueFrom:
    secretKeyRef:
      name: {{ include "woo-store.secretName" . }}
      key: mcp-token
- name: MCP_ALLOWED_HOSTS
  value: {{ printf "%s,%s:*,%s.%s,%s.%s:*,%s.%s.svc,%s.%s.svc:*,%s.%s.svc.cluster.local,%s.%s.svc.cluster.local:*" $svc $svc $svc $ns $svc $ns $svc $ns $svc $ns $svc $ns $svc $ns | quote }}
- name: LOG_LEVEL
  value: info
{{- end }}

{{/* Restricted-profile container hardening for our Python images (DESIGN §8.5). */}}
{{- define "woo-store.pythonSecurityContext" -}}
runAsNonRoot: true
runAsUser: 10001
runAsGroup: 10001
allowPrivilegeEscalation: false
readOnlyRootFilesystem: true
capabilities:
  drop: ["ALL"]
seccompProfile:
  type: RuntimeDefault
{{- end }}

{{/* NetworkPolicy egress rule: cluster DNS (kube-system pods k8s-app=kube-dns), UDP + TCP 53. */}}
{{- define "woo-store.dnsEgress" -}}
- to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kube-system
      podSelector:
        matchLabels:
          k8s-app: kube-dns
  ports:
    - {port: 53, protocol: UDP}
    - {port: 53, protocol: TCP}
{{- end }}

{{/* NetworkPolicy egress rule: public internet :80/:443, private and link-local ranges excluded. */}}
{{- define "woo-store.publicWebEgress" -}}
- to:
    - ipBlock:
        cidr: 0.0.0.0/0
        except:
          {{- toYaml .Values.networkPolicy.privateCidrs | nindent 10 }}
  ports:
    - {port: 80, protocol: TCP}
    - {port: 443, protocol: TCP}
{{- end }}
