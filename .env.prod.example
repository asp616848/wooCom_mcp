# Copy to .env.prod (git-ignored) and fill in. Read by the Makefile (ENV=prod) and scripts/prod-secrets.sh.
# Never commit real values or paste them in chat.

# Public IPv4 of the VPS. Hosts become shop/dashboard/gateway.<ip-with-dashes>.sslip.io
VPS_IP=
# GitHub owner of the GHCR images (ghcr.io/<owner>/wmg-<svc>:<short sha>, built by .github/workflows/release.yml)
GH_OWNER=
# Chat agent key (optional; without it /api/chat answers 503)
GEMINI_API_KEY=
# optional fallback key: one retry when GEMINI_API_KEY fails (quota, outage, bad key)
GEMINI_API_KEY_2=
